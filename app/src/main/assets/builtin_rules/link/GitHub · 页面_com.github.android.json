{
  "name": "GitHub · 页面",
  "category": "link",
  "enabled": true,
  "actionMode": "direct_open",
  "priority": 0,
  "matchRegex": ".*(?<![\\w.-])(?:www\\.)?github\\.com/(?!.*(?:releases/download/|archive/refs/)).*|.*gist\\.github\\.com.*",
  "parameterRegex": "(https?:\\/\\/[^\\s]+)",
  "triggerRegexes": [
    ".*(?<![\\w.-])(?:www\\.)?github\\.com/(?!.*(?:releases/download/|archive/refs/)).*|.*gist\\.github\\.com.*"
  ],
  "extractionRegexes": [
    "(https?:\\/\\/[^\\s]+)"
  ],
  "parseAfterRedirect": false,
  "clearClipboardAfterJump": true,
  "target": {
    "type": "url",
    "template": "${url:input}",
    "packageName": "com.github.android",
    "action": "android.intent.action.VIEW"
  }
}
